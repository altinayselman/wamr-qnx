diff --git a/core/shared/platform/common/posix/posix_file.c b/core/shared/platform/common/posix/posix_file.c
index d90f38e..e97c577 100644
--- a/core/shared/platform/common/posix/posix_file.c
+++ b/core/shared/platform/common/posix/posix_file.c
@@ -7,7 +7,7 @@
 #include "libc_errno.h"
 #include <unistd.h>
 
-#if !defined(__APPLE__) && !defined(ESP_PLATFORM)
+#if !defined(__APPLE__) && !defined(ESP_PLATFORM) && !defined(__QNX__)
 #define CONFIG_HAS_PWRITEV 1
 #define CONFIG_HAS_PREADV 1
 #else
@@ -962,6 +962,31 @@ os_readdir(os_dir_stream dir_stream, __wasi_dirent_t *entry,
     entry->d_ino = 0;
 #endif
 
+#if defined(__QNX__)
+    /* QNX's struct dirent has no d_type: classify the entry with lstat
+       semantics relative to the open directory. */
+    {
+        struct stat st;
+
+        if (fstatat(dirfd(dir_stream), dent->d_name, &st, AT_SYMLINK_NOFOLLOW)
+            != 0)
+            entry->d_type = __WASI_FILETYPE_UNKNOWN;
+        else if (S_ISBLK(st.st_mode))
+            entry->d_type = __WASI_FILETYPE_BLOCK_DEVICE;
+        else if (S_ISCHR(st.st_mode))
+            entry->d_type = __WASI_FILETYPE_CHARACTER_DEVICE;
+        else if (S_ISDIR(st.st_mode))
+            entry->d_type = __WASI_FILETYPE_DIRECTORY;
+        else if (S_ISFIFO(st.st_mode) || S_ISSOCK(st.st_mode))
+            entry->d_type = __WASI_FILETYPE_SOCKET_STREAM;
+        else if (S_ISLNK(st.st_mode))
+            entry->d_type = __WASI_FILETYPE_SYMBOLIC_LINK;
+        else if (S_ISREG(st.st_mode))
+            entry->d_type = __WASI_FILETYPE_REGULAR_FILE;
+        else
+            entry->d_type = __WASI_FILETYPE_UNKNOWN;
+    }
+#else
     switch (dent->d_type) {
         case DT_BLK:
             entry->d_type = __WASI_FILETYPE_BLOCK_DEVICE;
@@ -991,6 +1016,7 @@ os_readdir(os_dir_stream dir_stream, __wasi_dirent_t *entry,
             entry->d_type = __WASI_FILETYPE_UNKNOWN;
             break;
     }
+#endif /* __QNX__ */
 
     return __WASI_ESUCCESS;
 }
diff --git a/core/shared/platform/common/posix/posix_memmap.c b/core/shared/platform/common/posix/posix_memmap.c
index d5cad88..383300f 100644
--- a/core/shared/platform/common/posix/posix_memmap.c
+++ b/core/shared/platform/common/posix/posix_memmap.c
@@ -83,7 +83,7 @@ os_mmap(void *hint, size_t size, int prot, int flags, os_file_handle file)
         map_prot |= PROT_EXEC;
 
 #if defined(BUILD_TARGET_X86_64) || defined(BUILD_TARGET_AMD_64)
-#ifndef __APPLE__
+#if !defined(__APPLE__) && !defined(__QNX__)
     if (flags & MMAP_MAP_32BIT)
         map_flags |= MAP_32BIT;
 #endif
@@ -138,6 +138,25 @@ os_mmap(void *hint, size_t size, int prot, int flags, os_file_handle file)
     }
 #endif /* end of BUILD_TARGET_RISCV64_LP64D || BUILD_TARGET_RISCV64_LP64 */
 
+#if defined(__QNX__) \
+    && (defined(BUILD_TARGET_X86_64) || defined(BUILD_TARGET_AMD_64))
+    /* QNX has no MAP_32BIT. AOT code on x86-64 must sit in the low 2 GB, so
+       ask the memory manager for space below 2 GB with MAP_BELOW, which
+       treats the hint as an upper bound rather than a preferred address. */
+    if (addr == MAP_FAILED && !hint && !(flags & MMAP_MAP_FIXED)
+        && (flags & MMAP_MAP_32BIT)) {
+        uint8 *below = (uint8 *)(uintptr_t)(2ULL * BH_GB - request_size);
+
+        addr =
+            mmap(below, request_size, map_prot, map_flags | MAP_BELOW, file, 0);
+        if (addr != MAP_FAILED
+            && (uintptr_t)addr + request_size > (uintptr_t)(2ULL * BH_GB)) {
+            munmap(addr, request_size);
+            addr = MAP_FAILED;
+        }
+    }
+#endif
+
     /* memory hasn't been mapped or was mapped failed previously */
     if (addr == MAP_FAILED) {
         /* try 5 times on EAGAIN or ENOMEM, and keep retrying on EINTR */
@@ -274,6 +293,13 @@ os_mprotect(void *addr, size_t size, int prot)
     if (!addr)
         return 0;
 
+#if defined(__QNX__)
+    /* Linux accepts mprotect() with length 0 as a no-op; QNX fails it with
+       EINVAL. A module with an initial memory of 0 pages commits 0 bytes. */
+    if (request_size == 0)
+        return 0;
+#endif
+
     if (prot & MMAP_PROT_READ)
         map_prot |= PROT_READ;
 
diff --git a/core/shared/platform/common/posix/posix_thread.c b/core/shared/platform/common/posix/posix_thread.c
index 80b7d65..45d09e8 100644
--- a/core/shared/platform/common/posix/posix_thread.c
+++ b/core/shared/platform/common/posix/posix_thread.c
@@ -15,6 +15,10 @@
 #include <TargetConditionals.h>
 #endif
 
+#if defined(__QNX__)
+#include <sys/storage.h> /* __tls(): per-thread stack range */
+#endif
+
 typedef struct {
     thread_start_routine_t start;
     void *arg;
@@ -457,6 +461,21 @@ os_thread_get_stack_boundary()
         addr += guard_size;
     }
     (void)stack_size;
+#elif defined(__QNX__)
+    /* QNX has no pthread_getattr_np(); the thread's own stack range is kept
+       in its thread local storage, which sits at the top of the stack.
+       __stackaddr is the lowest address and the guard page lies below it. */
+    {
+        struct _thread_local_storage *tls = __tls();
+
+        (void)self;
+        if (tls && tls->__stackaddr && tls->__stacksize) {
+            addr = (uint8 *)tls->__stackaddr;
+            stack_size = tls->__stacksize;
+            if (stack_size > max_stack_size)
+                addr = addr + stack_size - max_stack_size;
+        }
+    }
 #elif defined(__APPLE__) || defined(__NuttX__) || defined(__RTTHREAD__)
     if ((addr = (uint8 *)pthread_get_stackaddr_np(self))) {
         stack_size = pthread_get_stacksize_np(self);
