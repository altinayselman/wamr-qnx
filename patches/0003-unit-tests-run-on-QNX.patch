         char cwd[1024] = { 0 };
 
+#if defined(__QNX__)
+        /* QNX has no /proc/self/exe link; /proc/self/exefile holds the path. */
+        {
+            FILE *exefile = fopen("/proc/self/exefile", "r");
+            if (exefile) {
+                size_t n = fread(cwd, 1, sizeof(cwd) - 1, exefile);
+                cwd[n] = '\0';
+                fclose(exefile);
+            }
+        }
+        if (cwd[0] == '\0') {
+#else
         if (readlink("/proc/self/exe", cwd, 1024) <= 0) {
+#endif
             return NULL;
         }
 
